# TODO: replace with the Zenodo concept DOI after first release.
# doi: "10.5281/zenodo.XXXXXXX"
keywords:
  - energy monitoring
  - non-intrusive load monitoring
  - NILM
  - power disaggregation
  - RF fingerprinting
  - EMI
  - anomaly detection
  - predictive maintenance
  - digital twin
  - observability
  - GNU Radio 4.0
  - signal processing
  - research infrastructure
  - Horizon Europe
  - iRIS
